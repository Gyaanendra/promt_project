# Copy this file to .env.local for local dev.
# On Vercel: Project -> Settings -> Environment Variables (add the same names).
# Keys are only ever read on the server (API routes). Never prefix them with NEXT_PUBLIC_.

# ---------- Attacker / Judge / Fixer model ("strong" model) ----------
# provider: anthropic | gemini | openai-compatible
STRONG_PROVIDER=anthropic
STRONG_MODEL=claude-sonnet-5-5

# Fill in the key(s) for the provider(s) you use:
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Only if STRONG_PROVIDER=openai-compatible (OpenAI, Groq, OpenRouter, ...):
# STRONG_BASE_URL=https://api.openai.com/v1
# STRONG_API_KEY=

# ---------- Target bot model (the chatbot under test) ----------
# Use a DIFFERENT model family from the judge so the judge is not grading its own outputs.
# Ollama does not run on Vercel, so use a hosted open-source model through any
# OpenAI-compatible API (Groq, Together, OpenRouter, Fireworks, ...).
TARGET_PROVIDER=openai-compatible
TARGET_MODEL=llama-3.1-8b-instant
TARGET_BASE_URL=https://api.groq.com/openai/v1
TARGET_API_KEY=

# For local dev with Ollama instead, use:
# TARGET_BASE_URL=http://localhost:11434/v1
# TARGET_MODEL=llama3.1
# TARGET_API_KEY=ollama

# ---------- Optional: protect the deployed app ----------
# If set, the UI asks for this passcode and every API call must send it.
# Strongly recommended on Vercel so strangers cannot burn your API credits.
APP_ACCESS_CODE=

# Max attacks per request batch (cost guard)
MAX_ATTACKS_PER_CALL=10
